# 构建产物(cmake out-of-source,不进 git)
door-guard/build/
door-guard/build-*/

# 交付产物大二进制(不进 git;本地保留,全量历史在局域网 Gitea)
deliverables/firmware/**/*.img
deliverables/firmware/**/MiniLoaderAll.bin
deliverables/wsl-toolchain/*.tar.gz

# Windows 复制残留(WSL 挂载 /mnt 或浏览器下载带入)
**/*:Zone.Identifier

# 模拟器运行时产物(db/key 自动生成,见 app/main.c)
door-guard/sim/data/

# 前端工程依赖与本地构建产物(node_modules 不入库;pages/ 才是入库的嵌入资源)
door-guard/services/web/frontend/node_modules/
door-guard/services/web/frontend/dist/
door-guard/services/web/web_pages.c.tmp

# 模型二进制不入 git(来源/角色/校验见 door-guard/models/README.md 与 sha256sums.txt)
door-guard/models/*.rknn
door-guard/models/*.data

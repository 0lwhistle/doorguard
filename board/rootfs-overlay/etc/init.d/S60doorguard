#!/bin/sh
# S60doorguard — door-guard 开机自启 + 应用级 OTA(A/B 槽位)
#
# 自启:udev(S10)/dhcpcd(S41)/dropbear(S50) 之后;监督循环崩溃 3s 拉起。
# OTA:上传闭环到 /var/lib/door-guard/ota_staged.bin(应用侧已验 sha256),
#       本脚本的监听循环做二次复核 → 装入非活动槽 → 符号链接原子切换 →
#       重启进程。连续 3 次秒退(<15s)自动回滚到另一槽。
# 槽位:/root/dg_app.A 与 /root/dg_app.B;/root/door-guard 是指向当前槽的
#       符号链接。开发流(dg-deploy 暂存)与生产 OTA(web 上传)同走
#       /var/lib/door-guard/ota_staged.bin,由 ota_watch 统一消费——任何
#       路径装的都是非活动槽,坏包秒退 3 次自动回滚,推板升级同一套防护。
DAEMON=/root/door-guard
SLOT_A=/root/dg_app.A
SLOT_B=/root/dg_app.B
APPDIR=/root
LOG=/var/log/door-guard.log
SUP_PID=/var/run/door-guard-sup.pid
WATCH_PID=/var/run/door-guard-ota.pid
STATE=/var/lib/door-guard
STAGED=$STATE/ota_staged.bin
STAGED_SHA=$STATE/ota_staged.bin.sha256
STAGED_VER=$STATE/ota_staged.ver

# ROCKIVA 人脸模型目录(B7):板上 /usr/lib 放模型文件——从 SDK
# external/iva/librockiva/rockiva-rk3576-Linux/*/model 拷入;缺模型时
# 应用降级为"无人脸检测"(日志 ERROR 明示),其余业务照常
export DG_IVA_MODEL_DIR="${DG_IVA_MODEL_DIR:-/usr/lib}"

# video plane 直通(2026-09-26 起 生产主线态):ARGB UI + NV12 硬件合成,
# 整机 CPU 28%→21%(与 v8 基线持平)。不开则回落软渲染;调试可临时
# DG_UI_PLANE=0 启动对比。注意须与 ARGB 配套——应用内开关已做门控
export DG_UI_PLANE="${DG_UI_PLANE:-1}"

log() { echo "$(date '+%F %T') $*" >>"$LOG"; }

# ---- 网络单客户端治理(2026-10-20)----
# 病根(buildroot 默认装配,板上实证):S40 ifup 起的 busybox udhcpc 与 S41
# 的 dhcpcd 同时对 eth0 跑 DHCP,client-id 不同(MAC vs DUID)在路由器侧是
# 两个租户,互踢 + 双地址/双默认路由打架,偶发"重启后连不上";且两边租约
# 都不持久,每次上电全新 DISCOVER,地址逐次漂移(.96→.98→.95)。
# 收敛:eth0 归 udhcpc 独管(ifup 那份实测能绑定续租,dhcpcd 在此板从未绑定
# 成功),每次 start 换成本脚本的受管实例:地址记入 /userdata/doorguard/
# last_ip,下次以 -r 请求同址对抗漂移。-9 杀(不给机会发 RELEASE/删地址;
# 断电重启本来也没有 ifdown)。S60 在 S41 之后跑,治理结果即开机终态。
net_govern() {
    if [ -f /var/run/dhcpcd/pid ]; then
        kill -9 "$(cat /var/run/dhcpcd/pid)" 2>/dev/null
        rm -f /var/run/dhcpcd/pid
    fi
    killall -9 dhcpcd 2>/dev/null
    ip link set eth0 up 2>/dev/null
    # eth0 的 udhcpc 一律换受管实例(restart 场景同参重建:-r 同址秒级重绑)。
    # -S 让租约事件进 syslog 便于排障;其余参数与 ifup 模板一致
    [ -f /var/run/udhcpc.eth0.pid ] && kill -9 "$(cat /var/run/udhcpc.eth0.pid)" 2>/dev/null
    lastip="$(cat /userdata/doorguard/last_ip 2>/dev/null)"
    if [ -n "$lastip" ]; then
        udhcpc -t1 -A3 -b -R -S -r "$lastip" -O search -O staticroutes \
            -p /var/run/udhcpc.eth0.pid -i eth0 >/dev/null 2>&1 &
    else
        udhcpc -t1 -A3 -b -R -S -O search -O staticroutes \
            -p /var/run/udhcpc.eth0.pid -i eth0 >/dev/null 2>&1 &
    fi
    # eth1 无线缆:ifup 起的那份 udhcpc 纯空转,停掉
    [ -f /var/run/udhcpc.eth1.pid ] && kill -9 "$(cat /var/run/udhcpc.eth1.pid)" 2>/dev/null
    # 后台记录本次拿到的地址(等 DHCP 落地,60s 上限;链路协商 ~5s,不拖慢启动)
    (
        n=0
        while [ "$n" -lt 60 ]; do
            ip="$(ip -4 addr show dev eth0 2>/dev/null | awk '/inet /{print $2}' | cut -d/ -f1)"
            case "$ip" in
                ""|169.254.*) sleep 1; n=$((n + 1)); continue ;;
            esac
            mkdir -p /userdata/doorguard
            [ "$(cat /userdata/doorguard/last_ip 2>/dev/null)" = "$ip" ] || \
                echo "$ip" > /userdata/doorguard/last_ip
            break
        done
    ) &
    log "网络治理:udhcpc 独管 eth0(上次地址 ${lastip:-无})"
}

aiq_restart() {
    killall rkaiq_3A_server 2>/dev/null
    start-stop-daemon -K -p /tmp/.rkaiq_3A 2>/dev/null
    rm -f /tmp/.rkaiq_3A /tmp/aiq2.lock
    /etc/init.d/S40rkaiq_3A start >/dev/null 2>&1
    n=0
    while [ $n -lt 10 ]; do
        pidof rkaiq_3A_server >/dev/null 2>&1 && return 0
        sleep 1
        n=$((n + 1))
    done
    return 1
}

slot_current() { basename "$(readlink "$DAEMON" 2>/dev/null)" 2>/dev/null; }

slot_other() {
    [ "$(slot_current)" = "dg_app.B" ] && { echo "$SLOT_A"; return; }
    echo "$SLOT_B"
}

slot_activate() { # $1=槽位路径;先建临时链接再 mv,切换原子
    ln -sf "$1" "$DAEMON.new" && mv -f "$DAEMON.new" "$DAEMON"
}

# 首次迁移:常规文件 → 槽位 A + 符号链接(幂等)
slot_migrate() {
    if [ -f "$DAEMON" ] && [ ! -L "$DAEMON" ]; then
        cp -f "$DAEMON" "$SLOT_A"
        slot_activate "$SLOT_A"
        log "槽位化:door-guard → dg_app.A"
    fi
}

ota_swap() {
    s1=$(stat -c %s "$STAGED" 2>/dev/null) || return 0
    sleep 2                                   # 收包完成判定:2s 大小不变
    s2=$(stat -c %s "$STAGED" 2>/dev/null) || return 0
    [ "$s1" = "$s2" ] || return 0
    if [ -f "$STAGED_SHA" ]; then             # 二次复核(应用侧已验过一次)
        if ! (cd "$STATE" && sha256sum -c ota_staged.bin.sha256 >/dev/null 2>&1); then
            log "OTA sha 复核失败,丢弃"
            rm -f "$STAGED" "$STAGED_SHA" "$STAGED_VER"
            return 0
        fi
    fi
    tgt=$(slot_other)
    cp -f "$STAGED" "$tgt" && chmod +x "$tgt" || { log "OTA 安装失败(拷贝)"; return 1; }
    slot_activate "$tgt"
    log "OTA 安装 $(basename "$tgt")(v=$(cat "$STAGED_VER" 2>/dev/null)),重启生效"
    rm -f "$STAGED" "$STAGED_SHA" "$STAGED_VER"
    killall door-guard 2>/dev/null            # 监督循环 3s 后拉起进新槽
}

ota_watch() {
    # pidfile 由 start 上下文以 $! 写(见 start 分支注释);函数内 $$ 会取到
    # start 主进程 pid,写进来就是失准的
    while :; do
        [ -f "$STAGED" ] && ota_swap
        sleep 2
    done
}

supervise() {
    fail=0
    while :; do
        ulimit -c unlimited          # 崩溃留 core(排障:core_pattern 由现场设)
        t0=$(date +%s)
        "$DAEMON" >>"$LOG" 2>&1
        rc=$?
        dt=$(( $(date +%s) - t0 ))
        log "door-guard 退出(rc=$rc,运行${dt}s)"
        if [ "$dt" -lt 15 ]; then
            fail=$((fail + 1))
        else
            fail=0
        fi
        # 连续 3 次秒退(含坏包 126/127——OTA 装了不能执行的包正是此形态)
        # 回滚到另一槽;回滚判定必须先于 126/127 跳过逻辑,否则永不触发(实测)
        if [ "$fail" -ge 3 ]; then
            other=$(slot_other)
            if [ -f "$other" ]; then
                slot_activate "$other"
                log "!!! 连续 3 次秒退,回滚 → $(basename "$other")"
                fail=0
            fi
        fi
        # 坏包(exec 失败 126/127)不涉及相机,跳过 3A 重启:
        # 快速循环里反复重启 aiq 服务曾把 ISP 驱动搅到内核崩溃(实测)
        if [ "$rc" = 126 ] || [ "$rc" = 127 ]; then
            sleep 2
            continue
        fi
        aiq_restart
        sleep 3
    done
}

case "$1" in
  start)
    { [ -f "$SLOT_A" ] || [ -f "$SLOT_B" ] || [ -f "$DAEMON" ]; } || {
        echo "door-guard 不存在,跳过"; exit 0; }
    mkdir -p "$STATE"
    net_govern                                  # 网络单客户端治理(见函数头注释)
    # IC 读卡 A 路方案(2026-10-14):内核 k7_rc522 退役(spi-gpio 总线上 probe
    # 必败且 rmmod 有段错误风险),用户态 iccard_daemon 经 spidev 直驱 RC522,
    # 帧进 FIFO(/tmp/dg_iccard.fifo)交付应用,应用侧配置 iccard.dev_path 已
    # 指向该 FIFO。**2026-10-14 起 K7 读卡链路挂起:须存在
    # /userdata/doorguard/.iccard_enable 标志文件才绑定+拉起,否则整段跳过
    # (应用侧 iccard.enabled=0 同步屏蔽);恢复=touch 该文件+重启,资产保留**
    if [ -f /userdata/doorguard/.iccard_enable ]; then
        if [ -d /sys/bus/spi/devices/spi7.0 ] && [ ! -e /sys/bus/spi/devices/spi7.0/driver ]; then
            echo spidev > /sys/bus/spi/devices/spi7.0/driver_override 2>/dev/null
            echo spi7.0 > /sys/bus/spi/drivers/spidev/bind 2>/dev/null \
                || log "spidev 绑定 spi7.0 失败,读卡器降级(其余业务不受影响)"
        fi
        if [ -x /userdata/doorguard/iccard_daemon ] && ! pidof iccard_daemon >/dev/null 2>&1; then
            /userdata/doorguard/iccard_daemon </dev/null >>"$LOG" 2>&1 &
        fi
    fi
    # 相机不在位时跳过 3A:librkaiq 在 sensor 实体缺失时库内空指针崩溃
    # (拔相机实测 rc=139 秒退;与 camera_board.c 注释的实体查找坑同类)。
    # 判据=i2c 传感器设备无驱动绑定(DT 恒枚举设备节点,插上才有 driver 链接)
    if [ ! -e /sys/bus/i2c/devices/8-0037/driver ]; then
        export DG_AIQ=0
        log "相机不在位,自动 DG_AIQ=0(裸流,相机/3A 相关业务降级)"
    fi
    if [ -f "$SUP_PID" ] && kill -0 "$(cat "$SUP_PID")" 2>/dev/null; then
        echo "door-guard 已在运行"; exit 0
    fi
    slot_migrate
    aiq_restart
    # ⚠️ 必须完全脱离会话:继承 ssh 的 stdout/stderr 时,会话一断,
    # 子 shell 往死管道写即被卡死(实测监督循环因此假死、回滚失灵)。
    # pidfile 用 $! 记后台子壳真实 pid:函数内 $$ 在 ash 里恒等于 start
    # 主进程 pid,主进程一退 pidfile 全指向死进程(stop 杀空气、start 的
    # "已在运行"守卫失效、部署脚本把活监听误判为死——2026-09-26 实测)
    supervise >/dev/null 2>&1 &
    echo $! >"$SUP_PID"
    ota_watch >/dev/null 2>&1 &
    echo $! >"$WATCH_PID"
    echo "door-guard 已启动(活动槽 $(slot_current),日志 $LOG)"
    ;;
  stop)
    # 忽略 TERM:下面 killall S60doorguard 的兜底会命中本进程自身
    # (busybox 按脚本名匹配),不忽略则 restart 路径的 start 永远执行不到
    trap '' TERM
    [ -f "$SUP_PID" ] && kill "$(cat "$SUP_PID")" 2>/dev/null
    [ -f "$WATCH_PID" ] && kill "$(cat "$WATCH_PID")" 2>/dev/null
    killall door-guard 2>/dev/null
    killall iccard_daemon 2>/dev/null
    killall rkaiq_3A_server 2>/dev/null
    rm -f "$SUP_PID" "$WATCH_PID" /tmp/.rkaiq_3A /tmp/aiq2.lock
    # 兜底必须最后:上一行先清干净 pidfile。按名 killall 会把 restart 的
    # 父脚本进程一并命中——父进程无 trap 护体,被杀后 start 分支永不执行,
    # restart 整体失灵(2026-10-14 实测);改逐 pid 杀,排除本进程($$,有
    # trap 护体)与调用方($PPID)
    for p in $(pidof S60doorguard); do
        if [ "$p" != "$$" ] && [ "$p" != "$PPID" ]; then
            kill "$p" 2>/dev/null
        fi
    done
    echo "door-guard 已停止"
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  *)
    echo "用法: $0 {start|stop|restart}"
    exit 1
    ;;
esac

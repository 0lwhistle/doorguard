 1 file changed, 15 insertions(+)
 create mode 100644 buildroot/package/cmake/0001-cmcppdap-add-cstdint-for-gcc15.patch

diff --git a/buildroot/package/cmake/0001-cmcppdap-add-cstdint-for-gcc15.patch b/buildroot/package/cmake/0001-cmcppdap-add-cstdint-for-gcc15.patch
new file mode 100644
index 000000000..0560fa4fc
--- /dev/null
+++ b/buildroot/package/cmake/0001-cmcppdap-add-cstdint-for-gcc15.patch
@@ -0,0 +1,15 @@
+From: door-guard project
+Subject: [PATCH] cmcppdap: add missing <cstdint> for GCC 15 hosts
+
+GCC 15 no longer pulls <cstdint> transitively, causing
+"'uint32_t' has not been declared" in dap/network.h when building
+host-cmake with very new host toolchains (Ubuntu 26.04 / GCC 15).
+--- a/Utilities/cmcppdap/include/dap/network.h
++++ b/Utilities/cmcppdap/include/dap/network.h
+@@ -17,6 +17,7 @@
+
+ #include <functional>
++#include <cstdint>
+ #include <memory>
+
+ namespace dap {

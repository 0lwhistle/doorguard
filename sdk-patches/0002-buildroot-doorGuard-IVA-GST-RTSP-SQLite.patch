+#!/bin/bash
+set -uo pipefail
+
+# ==============================================
+# Script: MD5 Check & Tar.gz Extractor
+# Version: 20260514
+# Update Log:
+# 1. Read target filename from md5sum file content
+# 2. Fixed filename matching logic
+# 3. All English output, no special characters
+# 4. Core features: MD5 verify, tar.gz extract, Git reset
+# ==============================================
+
+verify_and_extract() {
+    local md5_file="$1"
+
+    local tar_file
+    tar_file=$(awk '{print $2}' "$md5_file" | head -n 1 | xargs)
+
+    if [ -z "$tar_file" ]; then
+        echo -e "\nError: No filename found in '$md5_file'. Skipping..."
+        return 1
+    fi
+
+    if [ ! -f "$tar_file" ]; then
+        echo -e "\nWarning: File '$tar_file' not found. Skipping..."
+        return 1
+    fi
+
+    echo -e "\n========================================"
+    echo "Verifying MD5 checksum for: $tar_file"
+    echo "========================================"
+    if md5sum -c --status "$md5_file"; then
+        echo "Checksum verification passed"
+    else
+        echo "Checksum verification failed. Skipping extraction..."
+        return 1
+    fi
+
+    local extract_dir="${tar_file%.tar.gz}"
+
+    if [ -d "$extract_dir" ]; then
+        echo -e "\nDirectory '$extract_dir' exists. Overwrite? (y/N)"
+        read -r confirm
+        if [[ ! "$confirm" =~ ^[yY]$ ]]; then
+            echo "Extraction cancelled for '$tar_file'"
+            return 0
+        fi
+        echo "Removing existing directory: $extract_dir"
+        rm -rf "$extract_dir"
+    fi
+
+    mkdir -p "$extract_dir"
+    echo "Extracting '$tar_file' to '$extract_dir'..."
+    if tar -zxf "$tar_file" -C "$extract_dir"; then
+        echo "Extraction completed successfully"
+    else
+        echo "Extraction failed"
+        rm -rf "$extract_dir"
+        return 1
+    fi
+
+    echo -e "\nStarting Git repository reset..."
+    local git_found=0
+    find "$extract_dir" -type d -name ".git" | while IFS= read -r git_dir; do
+        git_found=1
+        local repo_dir
+        repo_dir=$(dirname "$git_dir")
+        (
+            cd "$repo_dir" || exit
+            echo "Resetting Git repo: $repo_dir"
+            git reset --hard -q && echo "Git reset completed" || echo "Git reset failed"
+        )
+    done
+
+    if [ "$git_found" -eq 0 ]; then
+        echo "No Git repositories found. Skipping Git reset..."
+    fi
+
+    return 0
+}
+
+clear
+echo "========================================"
+echo "MD5 Check & Tar.gz Extractor"
+echo "Version: 20260514"
+echo "Processing files in current directory..."
+echo "========================================"
+
+find . -maxdepth 1 -type f \( -name "*.md5" -o -name "*.md5sum" \) | while IFS= read -r md5_file; do
+    md5_file=$(basename "$md5_file")
+    echo -e "\n========================================"
+    echo "Processing file: $md5_file"
+    echo "========================================"
+    verify_and_extract "$md5_file"
+done
+
+echo -e "\n========================================"
+echo "All files processed"
+echo "========================================"
+exit 0

#!/usr/bin/env bash
# 推送 door-guard 到板子。用法: dg-deploy [-r] [板子IP]
#   -r   推送后立即在板上运行(串口/SSH 均可看到输出)
#   IP   缺省用 $DOORGUARD_IP(env.sh 里 export)
set -euo pipefail

: "${DOORGUARD_ROOT:?请先 source env/env.sh}"

run=0
if [ "${1:-}" = "-r" ]; then
    run=1
    shift
fi
ip="${1:-${DOORGUARD_IP:-}}"
[ -n "$ip" ] || { echo "用法: dg-deploy [-r] <板子IP>,或先 export DOORGUARD_IP=<IP>"; exit 1; }

bin="$DOORGUARD_ROOT/door-guard/build/door-guard"
[ -x "$bin" ] || { echo "没有编译产物,先执行 dg-build"; exit 1; }

scp "$bin" "root@$ip:/root/door-guard"

# 语言包(i18n 依赖 /root/ui/lang;CWD=/root 才能找到)与自启脚本(幂等)
ssh "root@$ip" 'mkdir -p /root/ui/lang'
scp "$DOORGUARD_ROOT"/door-guard/ui/lang/*.json "root@$ip:/root/ui/lang/" 2>/dev/null || true
if [ -f "$DOORGUARD_ROOT/board/rootfs-overlay/etc/init.d/S60doorguard" ]; then
    scp -q "$DOORGUARD_ROOT/board/rootfs-overlay/etc/init.d/S60doorguard" "root@$ip:/etc/init.d/S60doorguard"
    ssh "root@$ip" 'chmod +x /etc/init.d/S60doorguard'
fi

if [ "$run" = 1 ]; then
    # 先停自启服务再前台跑,避免双实例抢 DRM/SQLite;退出后手动 start 恢复
    ssh "root@$ip" '/etc/init.d/S60doorguard stop >/dev/null 2>&1; cd /root && /root/door-guard'
else
    echo "已推送(二进制+语言包+自启脚本)。板上运行: /etc/init.d/S60doorguard start"
fi

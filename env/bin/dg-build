#!/usr/bin/env bash
# 编译 door-guard(WSL 交叉编译)。用法: dg-build [-c] [追加的 cmake 配置参数...]
#   -c   删掉 build/ 全新配置(工具链/工具链文件变更后用)
set -euo pipefail

: "${DOORGUARD_ROOT:?请先 source env/env.sh}"

clean=0
if [ "${1:-}" = "-c" ]; then
    clean=1
    shift
fi

cd "$DOORGUARD_ROOT/door-guard"
[ "$clean" = 1 ] && rm -rf build

cmake -B build -DCMAKE_TOOLCHAIN_FILE=cmake/aarch64.cmake "$@"
cmake --build build -j"$(nproc)"

echo
echo "产物: door-guard/build/door-guard   (推送板子: dg-deploy [-r] [IP])"

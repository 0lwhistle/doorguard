#!/usr/bin/env bash
# PC 模拟器构建(WSL 宿主 gcc + SDL2,720×1280)。用法: dg-build-pc [-r] [-c] [透传 cmake 参数]
#   -r  构建后直接运行模拟器(需图形环境/WSLg)
#   -c  删掉 build-pc 全新配置
set -euo pipefail

: "${DOORGUARD_ROOT:?请先 source env/env.sh}"

run=0; clean=0
while [ $# -gt 0 ]; do
    case "$1" in
        -r) run=1; shift ;;
        -c) clean=1; shift ;;
        *) break ;;
    esac
done

cd "$DOORGUARD_ROOT/door-guard"
# 构建目录在 WSL 内默认走 ext4(env.sh 的 DG_PC_BUILD_DIR),configure 按需跑
# ——与 dg-build 同一套提速逻辑,理由见其头注(2026-09-29)
BUILD_DIR="${DG_PC_BUILD_DIR:-build-pc}"
[ "$clean" = 1 ] && rm -rf "$BUILD_DIR"
if [ ! -f "$BUILD_DIR/CMakeCache.txt" ]; then
    cmake -B "$BUILD_DIR" -DDG_SIM=ON "$@"
fi
cmake --build "$BUILD_DIR" -j"$(nproc)"

echo
echo "产物: $BUILD_DIR/door-guard"
if [ "$run" = 1 ]; then
    cd "$DOORGUARD_ROOT/door-guard"       # 相对路径:lang/configs/sim 目录
    exec "$BUILD_DIR/door-guard"
fi

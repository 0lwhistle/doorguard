#!/usr/bin/env python3
# dg-ota-pack — door-guard 全量升级包打包工具(生成 .ota)
#
# 用法:
#   dg-ota-pack <app二进制> <输出.ota> [--version V] [--date YYYY-MM-DD]
#
# 包格式(services/ota/ota_package.h 契约,大端):
#   0: magic "DGOTA1\0\0" | 8: u32 header_len=96 | 12: u32 payload_size
#   16: version[32] | 48: date[16] | 64: sha256[32] 原始摘要 | 96: 载荷
#
# 版本默认取当前 git describe(建议先打 tag 或用纯 x.y.z——设备端版本
# 比较只认点分数字前缀,见 ota_update.c)。流式处理,包大小不受内存限制。
import argparse
import hashlib
import os
import struct
import subprocess
import sys

MAGIC = b"DGOTA1\x00\x00"
HEADER_LEN = 96


def git_describe():
    try:
        out = subprocess.run(["git", "describe", "--tags", "--always", "--dirty"],
                             capture_output=True, text=True, check=True)
        return out.stdout.strip()
    except Exception:
        return "unknown"


def main():
    ap = argparse.ArgumentParser(description="打包 door-guard .ota 全量升级包")
    ap.add_argument("app", help="应用二进制(交叉编译产物 door-guard)")
    ap.add_argument("out", help="输出 .ota 路径")
    ap.add_argument("--version", default=None, help="包内版本(默认 git describe)")
    ap.add_argument("--date", default=None, help="发布日期 YYYY-MM-DD(默认今天)")
    args = ap.parse_args()

    size = os.path.getsize(args.app)
    if size <= 0:
        sys.exit(f"错误:{args.app} 不是非空文件")
    if size > 64 * 1024 * 1024:
        sys.exit(f"错误:载荷 {size}B 超过 64MB 上限")

    version = args.version or git_describe()
    if len(version.encode()) >= 32:
        sys.exit(f"错误:版本串过长(≥32B):{version}")
    date = args.date
    if not date:
        date = subprocess.run(["date", "+%Y-%m-%d"], capture_output=True,
                              text=True).stdout.strip() or "1970-01-01"

    # 摘要(流式)
    h = hashlib.sha256()
    with open(args.app, "rb") as f:
        while True:
            chunk = f.read(1 << 20)
            if not chunk:
                break
            h.update(chunk)
    digest = h.digest()

    hdr = bytearray(HEADER_LEN)
    hdr[0:8] = MAGIC
    struct.pack_into(">I", hdr, 8, HEADER_LEN)
    struct.pack_into(">I", hdr, 12, size)
    hdr[16:16 + len(version.encode())] = version.encode()
    hdr[48:48 + len(date.encode())] = date.encode()
    hdr[64:96] = digest

    with open(args.out, "wb") as out, open(args.app, "rb") as f:
        out.write(hdr)
        while True:
            chunk = f.read(1 << 20)
            if not chunk:
                break
            out.write(chunk)

    print(f"已生成 {args.out}")
    print(f"  版本 {version}  日期 {date}")
    print(f"  载荷 {size}B  sha256 {digest.hex()}")


if __name__ == "__main__":
    main()
